# monet-dashboard 本番環境変数（Railway の Variables に設定する。実値は .env には置かず Railway 側に登録）
#
# DB: Railway の MySQL プラグインが供給する接続URL（プラグイン作成後に参照変数で自動注入も可）
DATABASE_URL=mysql://user:password@host:port/dbname

# 管理者ログイン（admin トークン発行に使用。全ページがこの認証の背後＝アクセス制御フェーズ1）
ADMIN_USERNAME=commit.1414@gmail.com
ADMIN_PASSWORD=（十分に強固なパスワード）

# トークン署名鍵（十分に長いランダム文字列。例: openssl rand -hex 32）
JWT_SECRET=（ランダム32バイト以上）

# 定期同期エンドポイント /api/scheduled/* の共有シークレット。
# 未設定の場合は該当エンドポイントは 503 で無効（デフォルト安全側）。
# Railway の cron から HTTP ヘッダ  x-cron-secret: <この値>  で叩く。
CRON_SECRET=（ランダム文字列）

# 本番は production。PORT は Railway が自動注入するため設定不要。
NODE_ENV=production
